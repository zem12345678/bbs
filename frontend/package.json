{
  "name": "bbs-community-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8850 --strictPort",
    "build": "vite build",
    "build:check": "npm run build && npm run check:bundle",
    "check:bundle": "node ../scripts/check-bundle-size.mjs --dir dist/assets --max-js-kb 500 --entry index --max-entry-js-kb 320",
    "e2e:mall": "node ../scripts/frontend-mall-e2e.mjs",
    "test": "node --test src/api.test.js src/lib/mallCoupons.test.js src/lib/mallErrors.test.js src/lib/mallProducts.test.js src/lib/notificationTargets.test.js src/lib/postMappers.test.js",
    "preview": "vite preview --host 127.0.0.1 --port 8850 --strictPort"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.1",
    "vite": "^7.2.7"
  }
}

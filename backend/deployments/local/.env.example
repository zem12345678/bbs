COMPOSE_PROJECT_NAME=bbs-local

MAILPIT_IMAGE=axllent/mailpit:latest

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Stateful dependencies are shared with other local projects and are never managed by BBS Compose.
# BBS Compose starts only its Mailpit container.
NACOS_URL=http://127.0.0.1:8848
ELASTICSEARCH_URL=http://127.0.0.1:9200
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_CONSOLE_URL=http://127.0.0.1:19001
MINIO_BUCKET=bbs-local
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
# Optional: enables direct object verification in backend/scripts/attachment-smoke.ps1.
MINIO_CONTAINER=

# bootstrap.{ps1,sh} injects these only into the local Nacos payload. They
# must be real local-only values in .env; placeholders are rejected.
BBS_LOCAL_GATEWAY_JWT_SECRET=replace-with-local-gateway-jwt-secret
BBS_LOCAL_USER_JWT_SECRET=replace-with-local-user-jwt-secret
BBS_LOCAL_USER_MFA_ENCRYPTION_KEY=replace-with-local-user-mfa-encryption-key
BBS_LOCAL_ADMIN_JWT_SECRET=replace-with-local-admin-jwt-secret
BBS_LOCAL_ADMIN_DEFAULT_PASSWORD=replace-with-local-admin-password
BBS_LOCAL_ADMIN_SECRET_ENCRYPTION_KEY=replace-with-local-admin-encryption-key
BBS_LOCAL_ADMIN_INTERNAL_AUTH_TOKEN=replace-with-local-admin-internal-token
BBS_LOCAL_USER_INTERNAL_AUTH_TOKEN=replace-with-local-user-internal-token
BBS_LOCAL_CHAT_INTERNAL_AUTH_TOKEN=replace-with-local-chat-internal-token
BBS_LOCAL_COMMENT_INTERNAL_AUTH_TOKEN=replace-with-local-comment-internal-token
BBS_LOCAL_CONTENT_INTERNAL_AUTH_TOKEN=replace-with-local-content-internal-token
BBS_LOCAL_CREDIT_INTERNAL_AUTH_TOKEN=replace-with-local-credit-internal-token
BBS_LOCAL_MALL_INTERNAL_AUTH_TOKEN=replace-with-local-mall-internal-token
BBS_LOCAL_FILE_INTERNAL_AUTH_TOKEN=replace-with-local-file-internal-token
BBS_LOCAL_FEED_INTERNAL_AUTH_TOKEN=replace-with-local-feed-internal-token
BBS_LOCAL_REACTION_INTERNAL_AUTH_TOKEN=replace-with-local-reaction-internal-token
BBS_LOCAL_NOTIFICATION_INTERNAL_AUTH_TOKEN=replace-with-local-notification-internal-token
BBS_LOCAL_SEARCH_INTERNAL_AUTH_TOKEN=replace-with-local-search-internal-token

BBS_ENV=local
NACOS_NAMESPACE=bbs-local
NACOS_GROUP=BBS_LOCAL
ETCD_ENDPOINTS=127.0.0.1:2379

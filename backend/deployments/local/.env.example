COMPOSE_PROJECT_NAME=bbs-local

MAILPIT_IMAGE=axllent/mailpit:latest

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Stateful dependencies are shared with other local projects and are never managed by BBS Compose.
# BBS Compose starts only its Mailpit container.
NACOS_URL=http://127.0.0.1:8848
ELASTICSEARCH_URL=http://127.0.0.1:9200
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_CONSOLE_URL=http://127.0.0.1:19001
MINIO_BUCKET=bbs-local
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
# Optional: enables direct object verification in backend/scripts/attachment-smoke.ps1.
MINIO_CONTAINER=

BBS_ENV=local
NACOS_NAMESPACE=bbs-local
NACOS_GROUP=BBS_LOCAL
ETCD_ENDPOINTS=127.0.0.1:2379

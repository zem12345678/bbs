COMPOSE_PROJECT_NAME=bbs-local

REDIS_IMAGE=redis:7-alpine
MONGO_IMAGE=mongo:8
KAFKA_IMAGE=bitnami/kafka:3.9.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
ETCD_IMAGE=bitnami/etcd:3.5
NACOS_IMAGE=nacos/nacos-server:v2.4.3
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.0
MINIO_IMAGE=minio/minio:latest
MAILPIT_IMAGE=axllent/mailpit:latest

REDIS_PORT=6379
MONGO_PORT=27017
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_UI_PORT=8088
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=bbs-local

BBS_ENV=local
NACOS_NAMESPACE=bbs-local
NACOS_GROUP=BBS_LOCAL
ETCD_ENDPOINTS=127.0.0.1:2379
